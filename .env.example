# AI API keys are entered in Nuvyn Settings and encrypted in SQLite.
# The master key is never stored in SQLite. If these variables are omitted,
# Nuvyn creates data/.nuvyn-master-key automatically on first API-key save.
# To manage the key yourself, use a 32-byte value encoded as 64 hexadecimal
# characters or base64, and keep it separate from SQLite backups.
# NUVYN_MASTER_KEY=

# Alternatively, point to a mounted secret file containing the same key.
# NUVYN_MASTER_KEY_FILE=/run/secrets/nuvyn_master_key

# Docker binds the host port to localhost by default. Set this only when
# you intentionally want LAN/public access and understand the exposure.
# NUVYN_BIND_ADDRESS=127.0.0.1
# NUVYN_PORT=3000

# Browser-facing authentication origin. It must match the URL users open.
# With Docker's default localhost binding this follows NUVYN_PORT:
# NUVYN_PUBLIC_ORIGIN=http://127.0.0.1:3000
# For a custom port, e.g. NUVYN_PORT=8088:
# NUVYN_PUBLIC_ORIGIN=http://127.0.0.1:8088
# A reverse proxy should set an explicit external HTTPS origin instead.
# NUVYN_PUBLIC_ORIGIN=https://nuvyn.example.com

# Optional first-run setup secret. If omitted, Nuvyn generates a one-time
# 32-byte fallback in memory and logs it once. Explicit values must contain
# at least 32 UTF-8 bytes and must never be committed.
# NUVYN_SETUP_TOKEN=

# Revoke existing sessions at startup (0/1).
# NUVYN_AUTH_REVOKE_SESSIONS_ON_START=0

# Bare-metal production defaults to 127.0.0.1. Set HOST explicitly for LAN access.
# HOST=127.0.0.1

# Git author identity used by the vault history feature when the vault repo
# has no local user.name / user.email configured.
# GIT_AUTHOR_NAME=nuvyn
# GIT_AUTHOR_EMAIL=nuvyn@localhost
