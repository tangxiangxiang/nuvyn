{
  "name": "nuvyn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck:client": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "start": "tsx server/prod.ts",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:history-integration && npm run test:recovery-integration",
    "test:unit": "vitest run --exclude server/__tests__/history-git.test.ts --exclude server/__tests__/history-routes.test.ts --exclude server/__tests__/history-folder-coordination.test.ts --exclude server/__tests__/ai-history-commit-message.test.ts --exclude server/__tests__/edit-program-closure.test.ts --exclude server/__tests__/crashRecovery.test.ts --exclude server/__tests__/crashRecovery.state-machine.test.ts --exclude server/__tests__/atomicTextWrite.test.ts --exclude server/__tests__/documentFileLifecycle.test.ts --exclude server/__tests__/createOnlyMove.test.ts",
    "test:tags-scale": "vitest run --config vitest.tags-scale.config.ts",
    "test:history-integration": "vitest run --config vitest.history.config.ts",
    "test:recovery-integration": "vitest run --config vitest.recovery.config.ts",
    "test:platform-smoke": "vitest run server/__tests__/prodConfig.test.ts server/__tests__/paths.test.ts server/__tests__/db.test.ts server/__tests__/mount.test.ts server/__tests__/createOnlyMove.test.ts server/__tests__/filesystem-platform-smoke.test.ts",
    "test:ui-foundation-spike": "vitest run src/ui/__tests__/naive-ui-foundation-spike.test.ts src/ui/__tests__/naiveTheme.test.ts src/ui/__tests__/NuvynUiRoot.test.ts",
    "test:feedback-overlay": "vitest run src/components/__tests__/ConfirmHost.test.ts src/components/__tests__/FeedbackHosts.test.ts",
    "test:watch": "vitest",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:e2e:draft-store": "node node_modules/@playwright/test/cli.js test --config=playwright.draft-store.config.ts",
    "test:e2e:auth": "node node_modules/@playwright/test/cli.js test --config=playwright.auth.config.ts",
    "test:deployment-auth": "node scripts/docker-auth-smoke.mjs",
    "test:deployment-vault-lifecycle": "node scripts/docker-vault-writer-lifecycle.mjs",
    "lint:brand": "node scripts/check-brand-residue.mjs",
    "lint:icons": "tsx scripts/icon-lint.ts --allow-file=src/components/MarkMap.vue --allow-file=src/components/Mermaid.vue",
    "lint:icons:strict": "tsx scripts/icon-lint.ts --strict --allow-file=src/components/MarkMap.vue --allow-file=src/components/Mermaid.vue",
    "generate:emoji": "node scripts/generate-emoji-data.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@excalidraw/excalidraw": "0.18.0-4e758db",
    "@hono/node-server": "^2.0.4",
    "@js-temporal/polyfill": "0.5.1",
    "@mdit/plugin-emoji": "1.1.1",
    "@shikijs/transformers": "^4.4.3",
    "@types/diff": "^7.0.2",
    "@vicons/tabler": "0.13.0",
    "@vueuse/core": "^14.3.0",
    "better-sqlite3": "12.11.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.10",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.23",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.16.47",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.15.0",
    "minisearch": "^7.2.0",
    "naive-ui": "2.45.3",
    "openai": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.4.3",
    "svg-pan-zoom": "^3.6.2",
    "tsx": "^4.22.4",
    "vue": "^3.5.34",
    "vue-router": "^4.4.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/svg-pan-zoom": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "monaco-editor": "^0.55.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.2.8"
  }
}
