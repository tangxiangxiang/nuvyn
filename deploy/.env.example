# Copy this file to /opt/nuvyn/.env on the production host.
# The real .env is intentionally untracked and must never contain source
# control credentials or be copied into the image.

# Use a full release tag, never an implicit latest fallback.
NUVYN_IMAGE=ghcr.io/tangxiangxiang/nuvyn:0.1.0-alpha.1

# Named volume for SQLite, managed keys, and other persistent runtime data.
# Normal single-instance production can keep the default value. Staging,
# smoke tests, and parallel instances must use a separate volume name, for
# example: NUVYN_DATA_VOLUME=nuvyn-alpha1-smoke-data
NUVYN_DATA_VOLUME=nuvyn-data

# Docker host publication. Keep the default on loopback unless an HTTPS
# reverse proxy or an intentional network boundary is configured.
NUVYN_BIND_ADDRESS=127.0.0.1
NUVYN_PORT=3000
NUVYN_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Host directory containing the user's Markdown vault and its own .git history.
NUVYN_CONTENT_DIR=./content

# Optional startup session revocation. Set to 1 only for an explicit security
# event or trusted restore.
NUVYN_AUTH_REVOKE_SESSIONS_ON_START=0

# Provide a real value through this untracked file for first-run setup, or
# leave it unset and read the one-time fallback from the private container log.
# The explicit value must contain at least 32 UTF-8 bytes.
# NUVYN_SETUP_TOKEN=replace-with-at-least-32-random-utf8-bytes

# Optional explicit AI credential key. Keep it outside Git and outside image
# layers. Use either the encoded value or a file mounted into the container.
# NUVYN_MASTER_KEY=replace-with-a-64-hex-character-key
# NUVYN_MASTER_KEY_FILE=/run/secrets/nuvyn_master_key

# Git identity used only when the vault's own local Git config has no identity.
GIT_AUTHOR_NAME=nuvyn
GIT_AUTHOR_EMAIL=nuvyn@localhost
